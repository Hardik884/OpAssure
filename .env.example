# Copy this file to .env and fill in real values locally.
# NEVER commit .env or real secrets.

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# ---------- Backend ----------
# Local example matching the POSTGRES_* values below (docker-compose db service).
DATABASE_URL=postgresql+psycopg2://opassure:opassure@localhost:5432/opassure
# Separate throwaway database for backend DB tests (they drop and reseed it).
TEST_DATABASE_URL=postgresql+psycopg2://opassure:opassure@localhost:5432/opassure_test
# Comma-separated browser origins allowed to call the API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000
# Optional: override "today" (YYYY-MM-DD). Unset = latest task date in the DB (2025-06-29 demo day).
DEMO_DATE=
# Seconds between replayed telemetry rows in the T001 demo (lower = faster demo).
REPLAY_INTERVAL_SECONDS=3

# ---------- PostgreSQL (docker-compose) ----------
POSTGRES_USER=opassure
POSTGRES_PASSWORD=opassure
POSTGRES_DB=opassure
POSTGRES_PORT=5432

# ---------- External services ----------
# synthetic (default, offline, deterministic) | live (WEATHER_API_URL with automatic synthetic fallback)
WEATHER_MODE=synthetic
# Open-Meteo-compatible hourly endpoint, e.g. https://api.open-meteo.com/v1/forecast
WEATHER_API_URL=
WEATHER_API_KEY=
LLM_API_KEY=
